# .dockerignore — files excluded from the Docker build context
#
# A smaller build context = faster builds and smaller images.
# These files are either secrets, generated artifacts, or dev-only
# and should never be baked into the container image.

# Secrets
.env

# Python artifacts
__pycache__
*.pyc
*.pyo
.venv
venv
env

# Node artifacts
frontend/node_modules
frontend/dist       # rebuilt inside Docker by Stage 1

# Django generated files
backend/db.sqlite3
backend/staticfiles
backend/frontend_build   # populated by Docker Stage 1 copy step

# Version control
.git
.gitignore

# OS
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
