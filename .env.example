# .env — Environment variables for FreeMAD
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# The .gitignore in this project already excludes it.
#
# ══════════════════════════════════════════════════════════════════════════
# MODEL PROVIDER SELECTION
# ══════════════════════════════════════════════════════════════════════════
#
# Choose ONE provider and fill in the corresponding section below.
# Set MODEL_PROVIDER to one of: google | openai | ollama | huggingface

MODEL_PROVIDER=ollama
# ── Google Gemini ─────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY="AIzaSyAvXM3NaC893IbPHnFAkFRuQG0TA9AY698"
# GEN_MODEL_NAME=gemini-2.0-flash

# ── OpenAI ────────────────────────────────────────────────────────────────
# Uncomment and fill in if MODEL_PROVIDER=openai
# API_KEY=sk-your-openai-key-here
# GEN_MODEL_NAME=gpt-4o

# ── Ollama (local) ────────────────────────────────────────────────────────
# Uncomment if MODEL_PROVIDER=ollama
API_BASE=http://localhost:11434
GEN_MODEL_NAME=gemma3:27b-cloud

# ── HuggingFace ───────────────────────────────────────────────────────────
# Uncomment if MODEL_PROVIDER=huggingface
# API_KEY=hf_your-token-here
# GEN_MODEL_NAME=meta-llama/Llama-3-8B-Instruct

# ══════════════════════════════════════════════════════════════════════════
# EMBEDDING MODEL
# Used to measure semantic similarity between agent responses.
# For Ollama: use "nomic-embed-text"
# For all others: any sentence-transformers model works, e.g.:
#   all-MiniLM-L6-v2  (fast, small)
#   all-mpnet-base-v2 (slower, more accurate)
# ══════════════════════════════════════════════════════════════════════════
EMB_MODEL_NAME=nomic-embed-text

# ══════════════════════════════════════════════════════════════════════════
# DEBATE CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════
N_AGENTS=3
R_ROUNDS=2

# ══════════════════════════════════════════════════════════════════════════
# DJANGO
# ══════════════════════════════════════════════════════════════════════════
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-real-secret-key

# Set to False in production (on Render)
DEBUG=True

# Add your Render subdomain when deploying, e.g.:
#   ALLOWED_HOSTS=localhost,127.0.0.1,myapp.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
